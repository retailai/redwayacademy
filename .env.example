# Redway Academy — example environment. Copy to .env and fill in real values.
# NEVER commit a real .env file. Placeholders only here.
APP_ENV=production
SECRET_KEY=change-me-to-a-long-random-secret
BASE_URL=https://redwayacademy.com

# MySQL on Hostinger (hPanel → Databases → MySQL Databases).
# Leave DB_DSN empty to use these four values.
DB_HOST=localhost
DB_NAME=u123456789_redway
DB_USER=u123456789_redway
DB_PASS=your-mysql-password-here

# Or use a full PDO DSN instead (local SQLite test):
# DB_DSN=sqlite:/home/youruser/redwayacademy-php/storage/redway.db
DB_DSN=

# Uploads (retake admit card + tabulation sheet), max 8 MB each.
UPLOAD_FOLDER=
MAX_UPLOAD_MB=8

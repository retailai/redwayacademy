# Redway Academy — example environment variables.
# Copy to .env for LOCAL development only. Never commit a real .env.
# On Hostinger, set these in the Python app environment settings instead.

# A long random secret, e.g. the output of: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret

# development or production
FLASK_ENV=development

# Optional: where the SQLite file lives (default: instance/redway.db)
# DATABASE_PATH=/home/youruser/redwayacademy/instance/redway.db

# Optional: max upload size in MB (default: 8)
# MAX_UPLOAD_MB=8

# Optional: where uploaded admit cards / tabulation sheets go
# UPLOAD_FOLDER=instance/uploads

# Optional: log file path
# LOG_FILE=instance/logs/redway.log
